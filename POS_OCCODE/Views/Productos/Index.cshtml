@model IEnumerable<POS_OCCODE.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Productos";
}

<style>
    .producto-card {
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        padding: 2rem;
        border: 1px solid #eaeaea;
    }

    .table-custom-header {
        background-color: var(--color-purple-dark, #5F2A62);
        color: #ffffff;
    }

    .btn-nuevo {
        background-color: var(--color-green-light, #A0DE59);
        color: #1a3800;
        font-weight: 600;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-nuevo:hover {
            background-color: var(--color-yellow, #F5C024);
            color: #1a3800;
            transform: translateY(-2px);
        }

    .btn-action-edit {
        color: var(--color-green-dark, #466B5A);
        background: none;
        border: none;
        font-weight: 500;
        transition: color 0.2s;
    }

        .btn-action-edit:hover {
            color: var(--color-purple-light, #A976C3);
        }

    .btn-action-delete {
        color: #dc3545;
        background: none;
        border: none;
        font-weight: 500;
        transition: color 0.2s;
    }

        .btn-action-delete:hover {
            color: #a71d2a;
        }

    .modal-header-custom {
        background-color: var(--color-purple-dark, #5F2A62);
        color: white;
    }

        .modal-header-custom .btn-close {
            filter: invert(1) grayscale(100%) brightness(200%);
        }
</style>

<div class="container mt-4 mb-5">
    <div class="producto-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="title-header mb-0" style="color: var(--color-purple-dark, #5F2A62); font-weight: 700;">Catálogo de Productos</h2>
            <button type="button" class="btn btn-nuevo px-4 py-2" data-bs-toggle="modal" data-bs-target="#modalCrear">
                + Nuevo Producto
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-custom-header">
                    <tr>
                        <th class="py-3 px-3 rounded-start">ID</th>
                        <th class="py-3 px-3">Nombre del Producto</th>
                        <th class="py-3 px-3">Precio Compra</th>
                        <th class="py-3 px-3">Precio Venta</th>
                        <th class="py-3 px-3 text-end rounded-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-3">@item.IdProducto</td>
                                <td class="px-3 fw-bold text-dark">@item.Nombre</td>
                                <td class="px-3">@item.PrecioCompra.ToString("C")</td>
                                <td class="px-3">@item.PrecioVenta.ToString("C")</td>
                                <td class="px-3 text-end">
                                    <button type="button" class="btn-action-edit me-3" data-bs-toggle="modal" data-bs-target="#modalEditar"
                                            data-bs-id="@item.IdProducto" data-bs-nombre="@item.Nombre"
                                            data-bs-compra="@item.PrecioCompra" data-bs-venta="@item.PrecioVenta">
                                        ✏️ Editar
                                    </button>

                                    <!-- Botón Eliminar ahora llama a la función de SweetAlert -->
                                    <button type="button" class="btn-action-delete" onclick="confirmarEliminacion(@item.IdProducto, '@item.Nombre')">
                                        🗑️ Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No hay productos registrados. ¡Agrega el primero!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ============================================== -->
<!-- FORMULARIO OCULTO PARA ELIMINAR CON SWEETALERT -->
<!-- ============================================== -->
<form id="form-eliminar" asp-action="Delete" method="post" style="display: none;">
    <input type="hidden" name="idProducto" id="delete-id" />
</form>

<!-- ============================================== -->
<!-- MODALES DE BOOTSTRAP (CREAR Y EDITAR) -->
<!-- ============================================== -->
<!-- Modal CREAR -->
<div class="modal fade" id="modalCrear" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0">
            <div class="modal-header modal-header-custom">
                <h5 class="modal-title fw-bold">Registrar Nuevo Producto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre del Producto</label>
                        <input type="text" name="Nombre" class="form-control" required maxlength="100" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Precio Compra (Q)</label>
                            <input type="number" step="0.01" min="0" name="PrecioCompra" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Precio Venta (Q)</label>
                            <input type="number" step="0.01" min="0" name="PrecioVenta" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-nuevo px-4">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal EDITAR -->
<div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0">
            <div class="modal-header modal-header-custom" style="background-color: var(--color-green-dark, #466B5A);">
                <h5 class="modal-title fw-bold">Editar Producto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Edit" method="post">
                <div class="modal-body">
                    <input type="hidden" name="IdProducto" id="edit-id" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre del Producto</label>
                        <input type="text" name="Nombre" id="edit-nombre" class="form-control" required maxlength="100" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Precio Compra (Q)</label>
                            <input type="number" step="any" min="0" name="PrecioCompra" id="edit-compra" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Precio Venta (Q)</label>
                            <input type="number" step="any" min="0" name="PrecioVenta" id="edit-venta" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" style="background-color: var(--color-purple-light, #A976C3); border:none;">Actualizar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- CDN de SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Llenar el Modal de Edición dinámicamente
        var modalEditar = document.getElementById('modalEditar');
        modalEditar.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;

            modalEditar.querySelector('#edit-id').value = button.getAttribute('data-bs-id');
            modalEditar.querySelector('#edit-nombre').value = button.getAttribute('data-bs-nombre');
            modalEditar.querySelector('#edit-compra').value = button.getAttribute('data-bs-compra').replace(',', '.');
            modalEditar.querySelector('#edit-venta').value = button.getAttribute('data-bs-venta').replace(',', '.');
        });

        // Función reutilizable de SweetAlert para confirmar eliminación
        function confirmarEliminacion(id, nombre) {
            Swal.fire({
                title: `¿Eliminar ${nombre}?`,
                text: "Esta acción no se puede deshacer.",
                icon: "warning",
                width: 500,
                padding: "2em",
                color: "#5F2A62", // Tu color morado
                showCancelButton: true,
                confirmButtonColor: "#dc3545",
                cancelButtonColor: "#A976C3", // Tu morado claro para cancelar
                confirmButtonText: "Sí, eliminar",
                cancelButtonText: "Cancelar",
                customClass: {
                    popup: 'mi-alerta',
                    container: 'mi-backdrop'
                },
                backdrop: true
            }).then((result) => {
                if (result.isConfirmed) {
                    // Si el usuario confirma, llenamos el input oculto y enviamos el form
                    document.getElementById('delete-id').value = id;
                    document.getElementById('form-eliminar').submit();
                }
            });
        }
    </script>
}