@model POS_OCCODE.Models.DevolucionesVentasEncabezado

@{
    ViewData["Title"] = "Registrar Devolución de Venta";
}

<style>
    .transaccion-card {
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        padding: 2rem;
        border: 1px solid #eaeaea;
        margin-bottom: 2rem;
    }

    .section-title {
        color: var(--color-purple-dark, #5F2A62);
        font-weight: 700;
        border-bottom: 2px solid var(--color-purple-light, #A976C3);
        padding-bottom: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .btn-agregar {
        background-color: var(--color-purple-light, #A976C3);
        color: white;
        font-weight: 600;
    }

        .btn-agregar:hover {
            background-color: var(--color-purple-dark, #5F2A62);
            color: white;
        }
</style>

<div class="container mt-4">
    <form asp-action="Create" id="form-devolucion">

        <!-- ENCABEZADO -->
        <div class="transaccion-card">
            <h4 class="section-title">Datos de la Nota de Crédito</h4>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-bold">Factura Original *</label>
                    <select asp-for="IdFactura" class="form-select" asp-items="ViewBag.IdFactura" required>
                        <option value="">-- No. Factura --</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Cliente *</label>
                    <select asp-for="IdCliente" class="form-select" asp-items="ViewBag.IdCliente" required>
                        <option value="">-- Seleccione Cliente --</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-bold">Fecha *</label>
                    <input asp-for="Fecha" type="date" class="form-control" required value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Serie NC (FEL)</label>
                    <input asp-for="SerieCreditoFel" class="form-control" placeholder="Ej. NC1" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Número NC (FEL)</label>
                    <input asp-for="NotaCreditoFel" class="form-control" />
                </div>
            </div>
        </div>

        <!-- DETALLE DE DEVOLUCIÓN -->
        <div class="transaccion-card">
            <h4 class="section-title">Artículos a Devolver</h4>

            <div class="row align-items-end mb-4 bg-light p-3 rounded">
                <div class="col-md-5">
                    <label class="form-label fw-bold text-muted">Línea de Factura Original</label>
                    <select id="selDetalleFactura" class="form-select" asp-items="ViewBag.IdDetalleFactura">
                        <option value="">Seleccione el producto de la factura...</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold text-muted">Cant. a Devolver</label>
                    <input type="number" id="txtCantidad" class="form-control" min="1" value="1" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold text-muted">Monto Reembolso (Q)</label>
                    <input type="number" id="txtPrecio" class="form-control" step="0.01" min="0" value="0.00" />
                </div>
                <div class="col-md-2">
                    <button type="button" id="btnAgregarDetalle" class="btn btn-agregar w-100">+ Añadir</button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="tablaDetalles">
                    <thead style="background-color: var(--color-green-dark, #466B5A); color: white;">
                        <tr>
                            <th>Referencia Factura - Producto</th>
                            <th class="text-center">Cant.</th>
                            <th class="text-end">Monto U.</th>
                            <th class="text-end">Subtotal NC</th>
                            <th class="text-center">X</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end fw-bold">TOTAL NOTA CRÉDITO:</td>
                            <td class="text-end fw-bold text-danger fs-5" id="lblTotalDevolucion">Q 0.00</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div id="divDetallesOcultos"></div>

            <div class="text-end mt-4">
                <a asp-action="Index" class="btn btn-secondary me-2">Cancelar</a>
                <button type="submit" class="btn btn-danger" style="font-weight: bold;">
                    Procesar Devolución
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let indexDetalle = 0;
        let totalGeneral = 0;

        @if (TempData["MensajeError"] != null)
        {
                <text>
                Swal.fire({ title: 'Error', text: '@TempData["MensajeError"]', icon: 'error', width: 500, padding: "2em", customClass: { popup: 'mi-alerta', container: 'mi-backdrop' }, backdrop: true });
                </text>
        }

        document.getElementById('btnAgregarDetalle').addEventListener('click', function () {
            const idDetalleFactura = document.getElementById('selDetalleFactura').value;
            const textDetalleFactura = document.getElementById('selDetalleFactura').options[document.getElementById('selDetalleFactura').selectedIndex].text;
            const cantidad = document.getElementById('txtCantidad').value;
            const precio = document.getElementById('txtPrecio').value;

            if (!idDetalleFactura || cantidad <= 0 || precio < 0) {
                Swal.fire('Atención', 'Complete la línea de factura, cantidad y monto.', 'warning');
                return;
            }

            const subtotal = parseFloat(cantidad) * parseFloat(precio);
            totalGeneral += subtotal;

            const tbody = document.querySelector('#tablaDetalles tbody');
            const tr = document.createElement('tr');
            tr.id = `fila-${indexDetalle}`;
            tr.innerHTML = `
                <td>${textDetalleFactura}</td>
                <td class="text-center">${cantidad}</td>
                <td class="text-end">Q ${parseFloat(precio).toFixed(2)}</td>
                <td class="text-end fw-bold text-danger subtotal-fila" data-val="${subtotal}">- Q ${subtotal.toFixed(2)}</td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarDetalle(${indexDetalle})">X</button>
                </td>
            `;
            tbody.appendChild(tr);

            const divOculto = document.getElementById('divDetallesOcultos');
            divOculto.insertAdjacentHTML('beforeend', `
                <div id="hidden-${indexDetalle}">
                    <input type="hidden" name="DevolucionesVentasDetalles[${indexDetalle}].IdDetalleFactura" value="${idDetalleFactura}" />
                    <input type="hidden" name="DevolucionesVentasDetalles[${indexDetalle}].Cantidad" value="${cantidad}" />
                    <input type="hidden" name="DevolucionesVentasDetalles[${indexDetalle}].Precio" value="${precio.replace('.', ',')}" />
                </div>
            `);

            actualizarTotal();
            indexDetalle++;
        });

        function eliminarDetalle(index) {
            const subtotalFila = parseFloat(document.querySelector(`#fila-${index} .subtotal-fila`).getAttribute('data-val'));
            totalGeneral -= subtotalFila;
            document.getElementById(`fila-${index}`).remove();
            document.getElementById(`hidden-${index}`).remove();
            actualizarTotal();
        }

        function actualizarTotal() {
            document.getElementById('lblTotalDevolucion').textContent = `Q ${totalGeneral.toFixed(2)}`;
        }

        document.getElementById('form-devolucion').addEventListener('submit', function (e) {
            if (document.querySelectorAll('#tablaDetalles tbody tr').length === 0) {
                e.preventDefault();
                Swal.fire('Atención', 'Debe agregar artículos a devolver.', 'warning');
            }
        });
    </script>
}