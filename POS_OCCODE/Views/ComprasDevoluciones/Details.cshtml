@model POS_OCCODE.Models.ComprasDevolucionesEnc

@{
    ViewData["Title"] = "Detalle de Devolución a Proveedor";
}

<style>
    .detalle-card {
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        padding: 2rem;
        border: 1px solid #eaeaea;
        margin-bottom: 2rem;
    }

    .section-title {
        color: var(--color-purple-dark, #5F2A62);
        font-weight: 700;
        border-bottom: 2px solid var(--color-purple-light, #A976C3);
        padding-bottom: 0.5rem;
        margin-bottom: 1.5rem;
    }
</style>

<div class="container mt-4">
    <div class="detalle-card">
        <h4 class="section-title mb-4">Nota de Débito Interna #@Model.IdDevolucion</h4>

        <div class="row mb-4 bg-light p-3 rounded border">
            <div class="col-md-3">
                <p class="text-muted mb-1 small fw-bold">Fecha</p>
                <p class="fs-5 text-dark fw-bold">@Model.Fecha.ToString("dd/MM/yyyy")</p>
            </div>
            <div class="col-md-4">
                <p class="text-muted mb-1 small fw-bold">Proveedor</p>
                <p class="fs-5 text-dark">@Model.IdProveedorNavigation.NombreProveedor</p>
            </div>
            <div class="col-md-2">
                <p class="text-muted mb-1 small fw-bold">Compra Afectada</p>
                <p class="fs-5 text-primary fw-bold">#@Model.IdFactura</p>
            </div>
            <div class="col-md-3">
                <p class="text-muted mb-1 small fw-bold">Documento (FEL)</p>
                <p class="fs-5 text-dark">
                    @(string.IsNullOrEmpty(Model.SerieCreditoFel) ? "Sin Documento" : $"{Model.SerieCreditoFel} - {Model.NotaCreditoFel}")
                </p>
            </div>
        </div>

        <h5 class="fw-bold mb-3" style="color: var(--color-green-dark, #466B5A);">Artículos Devueltos</h5>
        <div class="table-responsive">
            <table class="table table-bordered">
                <thead style="background-color: var(--color-purple-light, #A976C3); color: white;">
                    <tr>
                        <th>Producto Devuelto</th>
                        <th class="text-center">Cant.</th>
                        <th class="text-end">Costo Recuperado U.</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detalle in Model.ComprasDevolucionesDets)
                    {
                        <tr>
                            <td class="fw-bold">@detalle.IdDetalleFacturaNavigation.IdProductoNavigation.Nombre</td>
                            <td class="text-center">@detalle.Cantidad</td>
                            <td class="text-end">@detalle.Precio.ToString("C")</td>
                            <td class="text-end fw-bold text-success">
                                +@((detalle.Cantidad * detalle.Precio).ToString("C"))
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="bg-light">
                    <tr>
                        <td colspan="3" class="text-end fw-bold fs-4">Total Recuperado:</td>
                        <td class="text-end fw-bold fs-4 text-success">
                            +@Model.ComprasDevolucionesDets.Sum(d => d.Cantidad * d.Precio).ToString("C")
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="text-end mt-4">
            <a asp-action="Index" class="btn btn-secondary">Volver al Historial</a>
        </div>
    </div>
</div>